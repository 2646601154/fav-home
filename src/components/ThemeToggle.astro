---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle', className]}
  data-theme-toggle
  aria-pressed="false"
  aria-label="切换到深色模式"
  title="切换深色 / 浅色模式"
>
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" focusable="false">
    <circle cx="10" cy="10" r="3.6"></circle>
    <path d="M10 1.6v2.1M10 16.3v2.1M1.6 10h2.1M16.3 10h2.1M4.1 4.1l1.5 1.5M14.4 14.4l1.5 1.5M15.9 4.1l-1.5 1.5M5.6 14.4l-1.5 1.5"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" focusable="false">
    <path d="M16.5 12.4A7 7 0 0 1 7.6 3.5a7 7 0 1 0 8.9 8.9Z"></path>
  </svg>
  <span class="sr-only" data-theme-toggle-text>切换主题</span>
</button>
